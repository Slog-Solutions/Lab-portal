{
  "name": "@lab/dictionary-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build-time pipeline: open-data dictionary sources -> dictionary.db (SPEC-offline-dictionary.md). Runs once on a connected build machine, never on the lab network.",
  "scripts": {
    "fetch": "tsx src/fetch-inputs.ts",
    "build": "tsc --noEmit && tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@lab/shared": "*",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "5.0.0",
    "rimraf": "6.0.1",
    "@types/node": "24.13.3"
  }
}
