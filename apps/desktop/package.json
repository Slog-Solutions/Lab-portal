{
  "name": "@lab/desktop",
  "productName": "LabPortal",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "clean": "rimraf dist release"
  },
  "dependencies": {
    "@lab/shared": "*",
    "@lab/native-bridge": "*",
    "socket.io-client": "4.8.3",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@lab/web": "*",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "@types/node": "24.13.3",
    "rimraf": "6.0.1",
    "vitest": "5.0.0"
  }
}
