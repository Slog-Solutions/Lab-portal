# Copy to .env and fill in for local dev. On the lab server, these live in
# infra/offline deployment config, never checked into git (see .gitignore).

NODE_ENV=development
PORT=3000

# docker compose -f infra/docker-compose.yml up -d  (or native Postgres — see infra/README.md)
DATABASE_URL="postgresql://labportal:labportal@localhost:5432/labportal?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-64-char-random-secret-before-any-real-deployment"

# LiveKit self-hosted (infra/livekit/livekit.yaml). devkey/devsecret match
# that file's dev defaults — MUST be regenerated for any real install.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_devsecret_devsecret"

LAB_DATA_ROOT="./LabData"
WEB_DIST_PATH="../web/dist"
UPDATES_DIR="./updates"

MAX_UPLOAD_MB=500
MAX_JSON_BODY_KB=2048

# Offline speech pipeline (Ser 7 pronunciation) — both optional. Absent
# means pronunciation activities still record/play back student audio but
# skip IPA generation and model-voice playback. Vendored under
# infra/offline/ for the real install; on a dev box, install eSpeak-NG and
# a Piper release + an en_GB/en_US ONNX voice and point these at them.
# ESPEAK_NG_BIN="C:\\Program Files\\eSpeak NG\\espeak-ng.exe"
# PIPER_BIN="C:\\tools\\piper\\piper.exe"
# PIPER_VOICES_DIR="C:\\tools\\piper\\voices"

# ---- Live class translation (services/translator, needs an NVIDIA GPU) ----
# Unset = the feature hides itself everywhere (no student language
# selector, no teacher toggle, no Speech Translation tab). That is the
# right state for a dev box or a lab server without a GPU, not an error.
# TRANSLATOR_URL=http://127.0.0.1:8080
# TRANSLATOR_API_KEY=
# Where the TRANSLATOR sees LAB_DATA_ROOT, if it differs from the path
# above (it does under Docker: /data/LabData). Leave unset when both
# processes read the same local path.
# TRANSLATOR_DATA_ROOT=
