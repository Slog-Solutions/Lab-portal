# Copy to .env and fill in for local dev. On the lab server, these live in
# infra/offline deployment config, never checked into git (see .gitignore).

NODE_ENV=development
PORT=3000

# docker compose -f infra/docker-compose.yml up -d  (or native Postgres — see infra/README.md)
DATABASE_URL="postgresql://labportal:labportal@localhost:5432/labportal?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-64-char-random-secret-before-any-real-deployment"

# LiveKit self-hosted (infra/livekit/livekit.yaml). devkey/devsecret match
# that file's dev defaults — MUST be regenerated for any real install.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_devsecret_devsecret"

LAB_DATA_ROOT="./LabData"
WEB_DIST_PATH="../web/dist"
