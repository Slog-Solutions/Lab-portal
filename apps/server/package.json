{
  "name": "@lab/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "clean": "rimraf dist generated",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@lab/shared": "*",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "12.0.1",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "12.0.1",
    "@prisma/client": "6.19.3",
    "adm-zip": "0.6.0",
    "bcryptjs": "3.0.2",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "helmet": "8.1.0",
    "livekit-server-sdk": "2.18.0",
    "pdfkit": "0.20.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/adm-zip": "0.5.8",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.5",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "prisma": "6.19.3",
    "rimraf": "6.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
