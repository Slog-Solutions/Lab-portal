// Digital Language Lab — core data model (build plan "Data model").
// Design note: entity names/relations mirror packages/shared/src/types
// enums so the server never re-derives what a status or role means.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================ Identity ===

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id            String   @id @default(cuid())
  role          UserRole
  serviceNumber String   @unique
  rank          String?
  fullName      String
  passwordHash  String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments         Enrollment[]
  taughtSessions      ClassSession[]   @relation("SessionTeacher")
  mediaAssets         MediaAsset[]
  contentPackages     ContentPackage[]
  curricula           Curriculum[]
  exercisesAuthored   Exercise[]       @relation("ExerciseTeacher")
  assignmentsGiven    Assignment[]     @relation("AssignmentTeacher")
  assignmentsReceived Assignment[]     @relation("AssignmentStudent")
  attempts            Attempt[]
  scoreOverrides      ScoreOverride[]
  auditLogs           AuditLog[]
  claimedStation      Station?
  studyProgress       SkillProgress[]
  batchesTaught       BatchTeacher[]   @relation("BatchTeacher")
  liveClasses         LiveClass[]      @relation("LiveClassTeacher")
  // A lock persisted against the student themself — follows them to
  // whatever seat they sign into (see LockGrant's doc comment).
  lockGrant           LockGrant?       @relation("LockSubject")
  locksIssued         LockGrant[]      @relation("LockIssuer")
  sessionMemberships  SessionMember[]  @relation("SessionMemberStudent")
  // CLASS_BROADCAST recordings this user (teacher/admin) started.
  createdRecordings   Recording[]      @relation("RecordingCreatedBy")

  @@index([role])
}

// LMS admin core: code is a separate human-typed display id (e.g.
// "ACTC-B01") — never the primary key, because every id DTO validates
// with z.string().cuid2() and a hyphenated code fails that check (see
// seed.ts's "hyphen-free" comment on the original hand-picked batch id).
// joinKey is admin-typed and stored plaintext deliberately — see
// BatchesService doc comment: the admin must be able to read it out to
// a room of trainees, and it only gates cohort attachment for an
// already-authenticated student, not account access.
model Batch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  joinKey   String
  joinOpen  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   Enrollment[]
  classSessions ClassSession[]
  teachers      BatchTeacher[]
  assignments   Assignment[]
  liveClasses   LiveClass[]
}

// Enforced teacher->batch assignment (LMS admin core). A teacher may only
// create/run a ClassSession for a batch they're assigned to; ADMIN
// bypasses this everywhere. See BatchScopeService.
model BatchTeacher {
  id         String   @id @default(cuid())
  batchId    String
  teacherId  String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher    User     @relation("BatchTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([batchId, teacherId])
  @@index([teacherId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  batchId    String
  enrolledAt DateTime @default(now())
  source     String   @default("ADMIN") // "ADMIN" | "SELF_JOIN"
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([userId, batchId])
}

// ================================================================ Lab ===

enum StationLifecycle {
  UNCLAIMED
  OFFLINE
  JOINING
  READY
  ACTIVE
  LOCKED
  ERROR
}

// Identity is machineGuid (HKLM MachineGuid — stable across rename/NIC
// swap, see design doc §3.7), NOT hostname or MAC. Seat 1 = teacher.
model Station {
  id            String           @id @default(cuid())
  machineGuid   String           @unique
  hostname      String
  macs          String[]
  seatNo        Int?             @unique
  lifecycle     StationLifecycle @default(UNCLAIMED)
  appVersion    String?
  osBuild       String?
  lastIp        String?
  lastSeenAt    DateTime?
  currentUserId String?          @unique
  currentUser   User?            @relation(fields: [currentUserId], references: [id])
  // Cleared together with currentUserId. Signing in needs no classroom code:
  // a claimed station may have no class at all until its student attaches it
  // to a teacher's live class (StationsService.attachToLiveClass). SetNull
  // rather than Cascade: a deleted LiveClass must not delete the Station row
  // it happened to seat.
  liveClassId   String?
  liveClass     LiveClass?       @relation(fields: [liveClassId], references: [id], onDelete: SetNull)
  enabled       Boolean          @default(true)
  archivedAt    DateTime? // set when "replace station" supersedes this row
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  sessionMembers SessionMember[]
  recordings     Recording[]
  auditLogs      AuditLog[]
  // Set only when nobody is currently seated here — an occupied seat's
  // lock lives on the student's own User row instead (see LockGrant).
  lockGrant      LockGrant?

  @@index([lifecycle])
  @@index([seatNo])
  @@index([liveClassId])
}

enum LiveClassState {
  ACTIVE
  ENDED
}

// A teacher-created classroom code (design decision: "the classroom
// works like a real classroom" — a teacher starts a class, students join
// with the code, the teacher controls only their own class's PCs). Not to
// be confused with ClassSession (a Batch-scoped, activity-driven lesson
// plan) — LiveClass is the lighter-weight "who's in the room right now"
// grouping that gates classroom-control scope and sign-in itself.
model LiveClass {
  id        String         @id @default(cuid())
  code      String         @unique
  title     String
  teacherId String
  teacher   User           @relation("LiveClassTeacher", fields: [teacherId], references: [id])
  state     LiveClassState @default(ACTIVE)
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  // Set when a teacher starts this live class FROM a specific My Classes
  // roster ("Start Live Class" on ClassDetailPage) rather than ad hoc from
  // Lab Control. Scopes two things: ClassroomService.start's bulk-attach of
  // every enrolled student already signed in, and StationsService.claim's
  // no-code auto-join for every enrolled student who signs in later while
  // this class stays ACTIVE — together, "without the code" for this
  // roster. Null for an ad-hoc class (unchanged pre-existing behavior:
  // still needs a typed code). SetNull rather than Cascade — deleting a
  // Batch must not delete a LiveClass row a station may still reference.
  batchId   String?
  batch     Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)

  stations   Station[]
  // CLASS_BROADCAST recordings made while this class was live.
  recordings Recording[]

  @@index([teacherId, state])
  @@index([batchId, state])
}

// Persisted INTENT only, not the lock lease itself (design doc §3.3, "a
// lease, not a latch") — LockService's in-memory maps stay the hot path
// and the source of truth a station's snapshot reads from; this table
// just lets the server re-assert every lock from Postgres after a
// restart. Exactly one of userId/stationId is set on a given row:
// userId when a student is seated (the lock follows them to whatever
// seat they sign into next — see LockService.setSeatOccupant), stationId
// for an idle PC with nobody signed in.
model LockGrant {
  id         String   @id @default(cuid())
  userId     String?  @unique
  stationId  String?  @unique
  mode       String   @default("soft") // 'soft' | 'windows' — see desired-state.ts's lock.mode
  screen     Boolean  @default(true)
  input      Boolean  @default(true)
  message    String?
  lockedById String
  lockedAt   DateTime @default(now())

  user     User?    @relation("LockSubject", fields: [userId], references: [id], onDelete: Cascade)
  station  Station? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  lockedBy User     @relation("LockIssuer", fields: [lockedById], references: [id])

  @@index([lockedById])
}

// ============================================================ Runtime ===

enum SessionState {
  DRAFT
  ARMED
  RUNNING
  PAUSED
  ENDED
  ABANDONED
}

enum SessionRole {
  MEMBER
  CHAIRMAN
  INTERPRETER
  DELEGATE
  OBSERVER
}

enum ActivityType {
  MODEL_IMITATION
  ROUND_TABLE
  CONTENT_EXERCISE
  VOCABULARY_TEST
  TELEPHONE
  PRONUNCIATION
  PRONUNCIATION_TEST
  WRITING_TEST
  LISTENING_TEST
  READING_TEST
  CONFERENCE_INTERPRETING
  PRESENTATION_RECORDING
  SELF_STUDY
}

// A teacher-defined set of stations partitioned into up to 6 groups
// (Annexure-I Ser 1: "divided into six different sessions... controlled
// separately and can simultaneously perform different activities").
model ClassSession {
  id        String       @id @default(cuid())
  title     String
  state     SessionState @default(DRAFT)
  seq       Int          @default(0) // monotonic, guards snapshot reordering
  teacherId String
  teacher   User         @relation("SessionTeacher", fields: [teacherId], references: [id])
  batchId   String
  batch     Batch        @relation(fields: [batchId], references: [id])
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  groups SessionGroup[]

  @@index([state])
}

model SessionGroup {
  id         String       @id @default(cuid())
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  index      Int // 1-6, position within the session
  chairmanId String? // SessionMember.id of the designated chairman (Ser 3)
  createdAt  DateTime     @default(now())

  members  SessionMember[]
  activity ActivityInstance?

  @@unique([sessionId, index])
}

model SessionMember {
  id        String       @id @default(cuid())
  groupId   String
  group     SessionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stationId String
  station   Station      @relation(fields: [stationId], references: [id])
  role      SessionRole  @default(MEMBER)
  // The student signed in at this seat when the group was built (and
  // re-stamped at arm/start for seats still empty then) — what a
  // student's class history reads, since the live engine itself is
  // seat-based. Null for a seat nobody was signed in at.
  studentId String?
  student   User?        @relation("SessionMemberStudent", fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([groupId, stationId])
  @@index([studentId])
}

// One group runs exactly one activity at a time; config/state are opaque
// JSON validated at the boundary against that ActivityType's zod schema
// in packages/shared/src/activities (Activity Type Registry).
model ActivityInstance {
  id                String       @id @default(cuid())
  groupId           String       @unique
  group             SessionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type              ActivityType
  config            Json
  state             Json         @default("{}")
  startedAt         DateTime?
  endedAt           DateTime?
  // Offline dictionary (SPEC-offline-dictionary.md §7) — null means "use
  // the activity type's own default" (see resolveDictionaryEnabled in
  // @lab/shared, which defaults VOCABULARY_TEST to false and everything
  // else to true); a teacher's explicit per-group toggle overrides that.
  // Lives as its own column, not inside `config`, because per-activity
  // config schemas (Activity Type Registry) validate away unknown keys.
  dictionaryEnabled Boolean?

  // SPEC-mcq-test-timed-reveal.md — set only for a VOCABULARY_TEST group
  // launched via "Launch in lab" (TimedTestsService.launch), linking this
  // one-shot live instance back to the saved Exercise it was built from
  // (SetNull on delete: deleting the exercise must not cascade into a
  // live/historical session). Null for every other activity, and for a
  // vocab test built through the generic Session Builder (no longer
  // possible going forward — see session-draft.ts — but old rows exist).
  exerciseId  String?
  exercise    Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  // Absolute epoch-ms deadline (design §4.1), persisted rather than held
  // only in a timer — see TestCloseService's own doc comment on why.
  closesAt    DateTime?
  // Set once (idempotently) by TestClockService.claimClose — the single
  // "has the close sequence for this instance already been claimed" gate
  // every closer (sweep, Reveal now, Extend's own expiry, session end)
  // shares, so running it twice is a no-op past this point.
  closedAt    DateTime?
  closeKind   String? // EXPIRED | REVEAL_NOW | NO_REVEAL | SESSION_ENDED
  revealedAt  DateTime?
  // Set once the reveal side effects (attempt grading + reveal + pushes)
  // have actually run — distinct from closedAt, which only marks that no
  // further answers are accepted. See TestCloseService.finalizeInstance.
  finalizedAt DateTime?

  attempts        Attempt[]
  recordings      Recording[]
  roundTableTurns RoundTableTurn[]

  @@index([finalizedAt, closesAt])
}

// Ser 3 Round Table: one stretch of speech, timed by the SERVER clock (ms
// since the activity started). Keyed by stationId, never studentId alone: a
// seat can be unclaimed at runtime, so studentId is nullable. A TEACHER turn
// has no station. No FKs to Station/User on purpose — a replaced station or
// deleted user must not erase the record of who spoke.
model RoundTableTurn {
  id                 String           @id @default(cuid())
  activityInstanceId String
  activityInstance   ActivityInstance @relation(fields: [activityInstanceId], references: [id], onDelete: Cascade)
  stationId          String?
  studentId          String?
  teacherUserId      String?
  role               String // CHAIRMAN | MEMBER | TEACHER
  startMs            Int
  endMs              Int
  createdAt          DateTime         @default(now())

  @@index([activityInstanceId])
}

// ============================================================ Content ===

enum MediaAssetScope {
  PRIVATE
  DEPARTMENT
  INSTITUTION
}

// Ser 1: "media library... multi teacher access facility for sharing and
// collaborating content resources remotely across the campus."
model MediaAsset {
  id             String          @id @default(cuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  scope          MediaAssetScope @default(PRIVATE)
  kind           String // 'audio' | 'video' | 'text' | 'image'
  title          String? // display name; falls back to filename
  filename       String
  path           String // relative to LabData root — see storage.ts buildAssetPath()
  sizeBytes      Int
  mimeType       String
  durationMs     Int?
  // Teacher opted this file into every student's Study Material (a loose file,
  // not attached to a module). Off by default: assets also land in the library
  // automatically (listening-test audio, generated model voice / IPA) and
  // must not leak to students. Never true for a PRIVATE asset.
  studentVisible Boolean         @default(false)
  // Classes (Batch ids) the file is shown to while studentVisible is on. Empty
  // means every student. A plain list rather than a relation on purpose: a
  // relation would cascade a deleted class out of the list, and an emptied list
  // reads as "everyone" — the one exposure this must never fall into. A dangling
  // id simply matches nobody.
  sharedBatchIds String[]        @default([])
  createdAt      DateTime        @default(now())

  items Item[]

  @@index([scope])
  @@index([ownerId])
}

// SCORM/xAPI/HTML import (build plan "engine + import + seed pack" decision)
model ContentPackage {
  id         String          @id @default(cuid())
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id])
  scope      MediaAssetScope @default(INSTITUTION)
  title      String
  format     String // 'SCORM12' | 'SCORM2004' | 'XAPI' | 'HTML'
  entryPoint String // path of the launch file, relative to `path`
  path       String // extracted package root, relative to LabData root
  sizeBytes  Int             @default(0)
  importedAt DateTime        @default(now())

  lessons Lesson[]
}

model Curriculum {
  id        String   @id @default(cuid())
  title     String
  cefrLevel String? // A1-C1, per Ser 10 "should follow CEFR"
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  units Unit[]
}

model Unit {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title        String
  order        Int

  lessons Lesson[]
}

model Lesson {
  id               String          @id @default(cuid())
  unitId           String
  unit             Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title            String
  order            Int
  contentPackageId String?
  contentPackage   ContentPackage? @relation(fields: [contentPackageId], references: [id])

  exercises Exercise[]
}

// Self-study (Ser 1: "session modules for students... self-study even
// when teacher not present")
model StudyModule {
  id               String   @id @default(cuid())
  title            String
  // The teacher's own guidance on how a student should use this module to
  // prepare (what to read first, what to practise, how long to spend).
  description      String?
  exerciseIds      String[]
  // Uploaded reference files (worksheets, PDFs, audio, video, images) a
  // teacher attaches next to the practice exercises — MediaAsset ids, kept
  // as a plain list for the same reason as exerciseIds (no relation: a
  // deleted asset just drops out of the module).
  materialAssetIds String[] @default([])
  createdAt        DateTime @default(now())
}

// ========================================================= Assessment ===

// Polymorphic by ActivityType; `config` validated against that type's
// configSchema from the Activity Type Registry.
model Exercise {
  id                String       @id @default(cuid())
  teacherId         String
  teacher           User         @relation("ExerciseTeacher", fields: [teacherId], references: [id])
  lessonId          String?
  lesson            Lesson?      @relation(fields: [lessonId], references: [id])
  type              ActivityType
  title             String
  config            Json
  createdAt         DateTime     @default(now())
  // Offline dictionary (SPEC-offline-dictionary.md §7) — same
  // null-means-default convention as ActivityInstance.dictionaryEnabled,
  // for the assignment-based (self-paced) path: a VOCABULARY_TEST
  // Exercise defaults the dictionary off during an attempt at it, same as
  // a live-session VOCABULARY_TEST group.
  dictionaryEnabled Boolean?
  // SPEC-mcq-test-timed-reveal.md §6.1 — "save without assigning": a test
  // built in the form builder and saved, but not yet sent to anyone via
  // Assignment (it may still be launched live via "Launch in lab"). Lets
  // AssessmentsService.list() show it even though `assignments` is empty.
  isAssessment      Boolean      @default(false)

  itemBank          ItemBank?
  assignments       Assignment[]
  attempts          Attempt[]
  activityInstances ActivityInstance[]

  @@index([teacherId])
  @@index([type])
}

// Ser 10 "Large Test Bank": a different set of questions each attempt.
model ItemBank {
  id         String   @id @default(cuid())
  exerciseId String   @unique
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  items Item[]
}

model Item {
  id           String      @id @default(cuid())
  itemBankId   String
  itemBank     ItemBank    @relation(fields: [itemBankId], references: [id], onDelete: Cascade)
  order        Int         @default(0) // authored order; randomization happens at serve time, not storage
  type         String      @default("SHORT_ANSWER") // 'MCQ' | 'SHORT_ANSWER'
  prompt       String
  answer       String
  choices      String[]
  cefrTag      String?
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])
  // SPEC-mcq-test-timed-reveal.md §5.2 — shown on the results screen after
  // reveal, never before (see projectConfigForStation / getResult).
  explanation  String?

  responses ItemResponse[]

  @@index([itemBankId])
}

// Ser 10 "teachers can create a special course... set hours... specify
// the score for students to attain"
model Assignment {
  id             String    @id @default(cuid())
  teacherId      String
  teacher        User      @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  exerciseId     String
  exercise       Exercise  @relation(fields: [exerciseId], references: [id])
  studentId      String
  student        User      @relation("AssignmentStudent", fields: [studentId], references: [id])
  targetScore    Float?
  allocatedHours Float?
  dueAt          DateTime?
  // The class it was created from (My Classes -> Create Assignment), if
  // any. A label for the student's class history — never authorises.
  batchId        String?
  batch          Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  attempts Attempt[]

  @@index([studentId])
  @@index([teacherId])
  @@index([batchId])
}

// rawScore/maxScore are stored on the scale native to the activity type
// (0-100 for CONTENT_EXERCISE/VOCABULARY_TEST, 0-5 for PRONUNCIATION's
// Likert self/teacher rating) — the gradebook normalizes to a percentage
// via rawScore/maxScore rather than forcing every activity onto one scale.
model Attempt {
  id                 String            @id @default(cuid())
  exerciseId         String
  exercise           Exercise          @relation(fields: [exerciseId], references: [id])
  studentId          String
  student            User              @relation(fields: [studentId], references: [id])
  assignmentId       String?
  assignment         Assignment?       @relation(fields: [assignmentId], references: [id])
  activityInstanceId String?
  activityInstance   ActivityInstance? @relation(fields: [activityInstanceId], references: [id])
  status             String            @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | SCORED
  // Snapshot of the exact Item ids (and order) served for this attempt —
  // makes randomized test-bank sampling reproducible/regradable without
  // re-deriving from the current (possibly since-edited) ItemBank.
  itemOrder          String[]          @default([])
  rawScore           Float?
  maxScore           Float?
  startedAt          DateTime          @default(now())
  submittedAt        DateTime?

  // SPEC-mcq-test-timed-reveal.md — a copy of the deadline this attempt is
  // bound by: the launched instance's ActivityInstance.closesAt for a
  // cohort attempt, or `startedAt + timeLimitSec*1000` for an individual
  // (assignment/self-study) one. Null for an untimed test. Copied rather
  // than looked up through activityInstanceId so a single conditional
  // `updateMany` on THIS row (see AttemptsService.saveDraft/finalizeVocabAttempt)
  // is enough to enforce the guard — no join needed on every answer.
  closesAt DateTime?
  // "Results visible from this instant" — a future timestamp, not a
  // boolean, so an individual ON_TIME_EXPIRY attempt can set this to its
  // own closesAt at submit time with no separate release sweep. Null
  // means "not released yet" (cohort test still running, or
  // ON_TEACHER_RELEASE awaiting the teacher). See resolveTestPolicy.
  revealAt DateTime?
  // Per-attempt ServedItem[] snapshot (prompt/choices in THIS attempt's
  // shuffled order/mediaAssetId — never the answer), so results can be
  // shown in the order the student actually saw them without re-deriving
  // from the exercise's current (possibly since-edited) config/bank.
  served   Json?
  // itemId -> given, both the in-progress draft (saveDraft) and the final
  // submitted answers — buffered here so a disconnect never loses them
  // (§8.1) and so an auto-submit at closesAt has something to grade.
  answers  Json?

  itemResponses ItemResponse[]
  scoreOverride ScoreOverride?
  recordings    Recording[]

  @@index([studentId])
  @@index([exerciseId])
  @@index([assignmentId])
  @@index([activityInstanceId])
  @@index([status, closesAt])
}

model ItemResponse {
  id          String   @id @default(cuid())
  attemptId   String
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  order       Int      @default(0)
  given       String
  correct     Boolean?
  score       Float?
  timeSpentMs Int?
}

enum RecordingKind {
  MODEL_IMITATION
  GROUP_DISCUSSION
  PRESENTATION
  INTERPRETATION
  PRONUNCIATION
  // Teacher-initiated recording of their own class broadcast (screen +,
  // optionally, mic/screen audio) — see ClassRecordingsController. Unlike
  // every other kind above, this is never created by a station.
  CLASS_BROADCAST
}

// Row is created BEFORE capture starts and reconciled via LiveKit webhook
// or client upload completion — never derived by parsing a filename
// (design doc §2.6).
model Recording {
  id                 String            @id @default(cuid())
  kind               RecordingKind
  sessionId          String?
  activityInstanceId String?
  activityInstance   ActivityInstance? @relation(fields: [activityInstanceId], references: [id])
  attemptId          String?
  attempt            Attempt?          @relation(fields: [attemptId], references: [id])
  stationId          String?
  station            Station?          @relation(fields: [stationId], references: [id])
  studentIds         String[]
  path               String? // null until finalized
  durationMs         Int?
  sizeBytes          Int?
  status             String            @default("pending") // pending | recording | finalizing | ready | failed
  createdAt          DateTime          @default(now())
  finalizedAt        DateTime?

  // CLASS_BROADCAST only, below — a teacher/admin recording, not a station one.
  liveClassId String?
  liveClass   LiveClass? @relation(fields: [liveClassId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?      @relation("RecordingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // Whether the class recording includes teacher mic + screen audio.
  withAudio   Boolean?
  // Next expected chunk sequence number for the streamed upload (design
  // doc: a 1-2h class recording streams in ~5s chunks, never one blob).
  chunkCount  Int        @default(0)
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([liveClassId])
  @@index([createdById])
}

model SkillProgress {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  skill      String // 'pronunciation' | 'listening' | 'reading' | 'grammar' | ...
  score      Float
  recordedAt DateTime @default(now())

  @@index([studentId, skill])
}

// ========================================================= Governance ===

// Ser 4: "Report tool... allow teachers to view, edit and save" — an edit
// is never a silent overwrite, it's an audited override.
model ScoreOverride {
  id        String   @id @default(cuid())
  attemptId String   @unique
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  oldScore  Float?
  newScore  Float
  reason    String
  createdAt DateTime @default(now())
}

// Offline dictionary lookup telemetry (SPEC-offline-dictionary.md §8,
// optional-but-built). No FKs to Station/Session/User, same reasoning as
// RoundTableTurn's own comment: a replaced station, an ended session or a
// deleted user must not erase the record of what was looked up, and a
// bounded-retention telemetry table (see DICTIONARY_LOG_RETENTION_DAYS)
// is exactly the kind of row that should degrade gracefully, not cascade.
model DictionaryLookup {
  id               String   @id @default(cuid())
  stationId        String?
  studentId        String?
  sessionId        String?
  word             String
  resolvedHeadword String?
  found            Boolean
  at               DateTime @default(now())

  @@index([at])
  @@index([studentId, at])
}

// Every privileged action — screen viewed, remote control started,
// station shut down, score edited — writes here (design doc §3.6).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  stationId String?
  station   Station? @relation(fields: [stationId], references: [id])
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([stationId])
}
