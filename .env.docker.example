# Copy to .env (next to docker-compose.yml) and fill in.
#   cp .env.docker.example .env

# The server's LAN IP as seen by the stations — LiveKit advertises it for media.
HOST_IP=192.168.1.10
# Name on the self-signed TLS certificate.
TLS_CN=lab.local

# Generate secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
LIVEKIT_API_KEY=labkey
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters

# Published ports on the host.
HTTP_PORT=80
HTTPS_PORT=443

MAX_UPLOAD_MB=500
# Set true ONCE for a first boot to create the demo admin/teacher/student
# accounts (see apps/server/prisma/seed.ts), then set back to false.
RUN_SEED=false
