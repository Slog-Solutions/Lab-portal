# Copy to .env (next to docker-compose.yml) and fill in.
#   cp .env.docker.example .env

# The server's LAN IP as seen by the stations — LiveKit advertises it for media.
HOST_IP=192.168.1.10
# Name on the self-signed TLS certificate.
TLS_CN=lab.local

# Generate secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
LIVEKIT_API_KEY=labkey
LIVEKIT_API_SECRET=change-me-to-at-least-32-random-characters

# Published ports on the host.
HTTP_PORT=80
HTTPS_PORT=443

MAX_UPLOAD_MB=500
# Set true ONCE for a first boot to create the demo admin/teacher/student
# accounts (see apps/server/prisma/seed.ts), then set back to false.
RUN_SEED=false

# ---- Live class translation, option A: Azure Speech (NO GPU needed) ----
# Recommended unless the server has a 12GB+ NVIDIA card. Azure does the
# recognition, translation and synthesis in one call, so this works on an
# ordinary lab server — but the server needs OUTBOUND INTERNET to
# *.cognitiveservices.azure.com (the stations still do not).
#
#   1. Paste the key below (Azure portal > your Speech resource > Keys
#      and Endpoint > KEY 1). Never commit the real .env.
#   2. TRANSLATOR_URL=http://translator-azure:8080
#   3. docker compose --profile translation-azure up -d --build
#
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# The language the teacher speaks, ISO-639-3 (eng, hin, tam, ...) — see
# packages/shared/src/translation/languages.ts.
AZURE_SOURCE_LANG=eng

# ---- Live class translation, option B: SeamlessStreaming (needs a GPU) ----
# Leave TRANSLATOR_URL EMPTY unless one of the translator profiles is
# running: unset means the feature hides itself everywhere, which is the
# correct state for a lab server with neither option configured. Set it to
# whichever service you started — the two must not run together.
#   Azure:    TRANSLATOR_URL=http://translator-azure:8080
#   Seamless: TRANSLATOR_URL=http://translator:8080
#             docker compose --profile translation up -d --build
TRANSLATOR_URL=
# Shared secret between the server and the translator. Required whenever
# the translation profile runs; generate like the others above.
TRANSLATOR_API_KEY=change-me-to-at-least-32-random-characters
# cuda (normal) — `cpu` is far too slow for live use and only exists for
# smoke-testing the HTTP surface.
TRANSLATOR_DEVICE=cuda
# fp16 halves VRAM and is what makes the 2.5B model fit on a 12GB card.
TRANSLATOR_DTYPE=fp16
# Concurrent (class x language) GPU streams. Raise only after measuring
# RTF on the Speech Translation > Test tab.
TRANSLATOR_MAX_STREAMS=4
