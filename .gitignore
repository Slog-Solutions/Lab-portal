# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
release/
out/
*.tsbuildinfo
.turbo/

# Native build artifacts (prebuilds/ committed intentionally, raw build dirs are not)
packages/native-bridge/build/
packages/native-bridge/CMakeFiles/

# Electron
apps/desktop/out/
apps/desktop/release/
# electron-builder's buildResources dir (installer.nsh, set-server-ip.ps1) —
# real source, not a build output; the generic "build/" rule above would
# otherwise swallow it since it happens to be named "build" too.
!apps/desktop/build/
!apps/desktop/build/**

# Env
.env
.env.local
.env.*.local
!.env.example

# Prisma
apps/server/prisma/*.db
apps/server/generated/

# Logs
*.log
npm-debug.log*
logs/

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Test / coverage
coverage/

# Local data (recordings, uploads) — never commit trainee data
infra/data/
LabData/

# Certs (generated locally, never committed)
infra/caddy/*.crt
infra/caddy/*.key
infra/offline/certs/

# Offline vendor installers (large binaries, fetched by a script not git)
infra/offline/vendor/

# Dictionary build inputs (large third-party release files, fetched by
# fetch-inputs.ts, checksummed in the COMMITTED dictionary-sources.json —
# see tools/dictionary-build/src/fetch-inputs.ts)
tools/dictionary-build/inputs/

# Local-only dev overrides (not committed)
.local/

# Hand-made .env backups — these hold REAL secrets (JWT_SECRET, DATABASE_URL,
# LiveKit keys) and the plain `.env` rule above does not match them.
.env.backup*
*.env.backup*

# Translation model weights, fetched by services/translator/scripts/fetch_models.py.
# Not needed at all when TRANSLATOR_ENGINE=azure.
models/

# Python build artifacts (services/translator)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
